# Lightroom Preset Decoder – Apache / LiteSpeed (Hostinger) configuration
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (Hostinger provides a free SSL certificate for subdomains)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Never serve stored data, config or page templates directly
  RewriteRule ^data(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.sample\.php)$ - [F,L]
  RewriteRule ^(app|login)\.html$ - [F,L]

  # Everything that is not a real file goes through index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .mjs .js
  AddType image/svg+xml .svg
</IfModule>
